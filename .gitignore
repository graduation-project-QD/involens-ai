!/experiments/data/processed/**/*_quarantine.jsonl

# Quarantined source documents: keep audit metadata, ignore document binaries
/experiments/data/quarantine/**/*.jpg
/experiments/data/quarantine/**/*.jpeg
/experiments/data/quarantine/**/*.png
/experiments/data/quarantine/**/*.pdf

